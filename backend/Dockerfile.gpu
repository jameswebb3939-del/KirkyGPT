FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y \
        build-essential \
        ca-certificates \
        curl \
        git \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*


# -----------------------------
# Python 3.13 via uv
# -----------------------------

RUN curl -LsSf \
    https://astral.sh/uv/install.sh \
    | sh

ENV PATH="/root/.local/bin:${PATH}"

RUN uv python install 3.13


WORKDIR /app


# -----------------------------
# Source
# -----------------------------

COPY pyproject.toml README.md ./

COPY src ./src

COPY native ./native


# -----------------------------
# Python environment
# -----------------------------

RUN uv venv \
    --python 3.13 \
    .venv

RUN uv pip install \
    --python .venv/bin/python \
    -e .

RUN uv pip install \
    --python .venv/bin/python \
    pybind11 \
    cmake \
    ninja


# -----------------------------
# Native CUDA build
# -----------------------------

RUN PYBIND11_DIR="$( \
        .venv/bin/python \
        -m pybind11 \
        --cmakedir \
    )" \
    && .venv/bin/cmake \
        -S native \
        -B native/build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -Dpybind11_DIR="${PYBIND11_DIR}" \
        -DGGML_CUDA=ON \
        -DEC_PRO_NATIVE_BUILD_TESTS=OFF \
    && .venv/bin/cmake \
        --build native/build \
        --config Release


# ==================================================
# Runtime image
# ==================================================

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y \
        ca-certificates \
        libgomp1 \
        libstdc++6 \
    && rm -rf /var/lib/apt/lists/*


WORKDIR /app


# uv-managed Python used by the venv
COPY --from=build \
    /root/.local/share/uv/python \
    /root/.local/share/uv/python


COPY --from=build \
    /app \
    /app


ENV PATH="/app/.venv/bin:${PATH}"

ENV PYTHONPATH="/app/src"

ENV SERVER_HOST="0.0.0.0"

ENV SERVER_PORT="8000"


EXPOSE 8000


CMD ["python", "-m", "uvicorn", "llm_followups.server.inference_app:app", "--host", "0.0.0.0", "--port", "8000"]