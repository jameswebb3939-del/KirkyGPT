FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu24.04 AS build

ARG CUDA_ARCHITECTURES=86

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y \
        build-essential \
        ca-certificates \
        curl \
        git \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*


# ==================================================
# Python 3.13 via uv
# ==================================================

RUN curl -LsSf \
    https://astral.sh/uv/install.sh \
    | sh

ENV PATH="/root/.local/bin:${PATH}"

RUN uv python install 3.13

WORKDIR /app


# ==================================================
# Native build tooling
#
# Keep this before application Python source so
# Python-only changes do not invalidate CUDA/C++.
# ==================================================

RUN uv venv \
    --python 3.13 \
    .build-venv

RUN uv pip install \
    --python .build-venv/bin/python \
    pybind11 \
    cmake \
    ninja


# ==================================================
# Native source only
#
# Tests are intentionally omitted because the
# production build disables native test targets.
# ==================================================

COPY native/CMakeLists.txt \
    ./native/CMakeLists.txt

COPY native/include \
    ./native/include

COPY native/src \
    ./native/src

COPY native/third_party/llama.cpp \
    ./native/third_party/llama.cpp


# ==================================================
# Native CUDA build
#
# CMake writes the Python extension to:
# /app/src/llm_followups/native/
#
# Save it separately before application src is
# copied into this stage.
# ==================================================

RUN mkdir -p \
        /app/src/llm_followups/native \
        /native-artifacts \
    && PYBIND11_DIR="$( \
        .build-venv/bin/python \
        -m pybind11 \
        --cmakedir \
    )" \
    && .build-venv/bin/cmake \
        -S native \
        -B native/build \
        -G Ninja \
        -DCMAKE_MAKE_PROGRAM=/app/.build-venv/bin/ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -Dpybind11_DIR="${PYBIND11_DIR}" \
        -DGGML_CUDA=ON \
        -DGGML_NATIVE=OFF \
        -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHITECTURES}" \
        -DEC_PRO_NATIVE_BUILD_TESTS=OFF \
    && .build-venv/bin/cmake \
        --build native/build \
        --config Release \
    && cp \
        /app/src/llm_followups/native/_ec_pro_native*.so \
        /native-artifacts/


# ==================================================
# Production Python dependencies
#
# These deliberately come after the native build.
# Dependency changes therefore do not recompile
# llama.cpp/CUDA.
# ==================================================

COPY requirements ./requirements

RUN uv venv \
    --python 3.13 \
    .venv

RUN uv pip install \
    --python .venv/bin/python \
    -r requirements/inference.txt


# ==================================================
# Application Python source
#
# Python-only changes invalidate from here onward,
# not the expensive native CUDA build above.
# ==================================================

COPY src ./src

RUN cp \
    /native-artifacts/_ec_pro_native*.so \
    /app/src/llm_followups/native/


# ==================================================
# Runtime image
# ==================================================

FROM nvidia/cuda:12.8.1-base-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y \
        --no-install-recommends \
        ca-certificates \
        libgomp1 \
        libstdc++6 \
        cuda-cudart-12-8=12.8.90-1 \
        libcublas-12-8=12.8.4.1-1 \
        libnccl2=2.25.1-1+cuda12.8 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app


# Python installation backing the uv-created venv.
COPY --from=build \
    /root/.local/share/uv/python \
    /root/.local/share/uv/python


# Minimal production Python environment.
COPY --from=build \
    /app/.venv \
    /app/.venv


# Application source plus compiled native extension.
COPY --from=build \
    /app/src \
    /app/src


ENV PATH="/app/.venv/bin:${PATH}"
ENV PYTHONPATH="/app/src"

ENV SERVER_HOST="0.0.0.0"
ENV SERVER_PORT="8000"

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "llm_followups.server.inference_app:app", "--host", "0.0.0.0", "--port", "8000"]
